TARGETS = main

# build options (WEBUI)
-include config.mk
WEBUI ?= 0
CXX = g++
#CXX = clang++

# UHD
UHD_CFLAGS := $(shell pkg-config --cflags uhd 2>/dev/null)

# Boost
BOOST_CFLAGS := $(shell pkg-config --cflags boost 2>/dev/null)

# FFTW3
FFTW_CFLAGS := $(shell pkg-config --cflags fftw3f 2>/dev/null)

# Flags (-ggdb?)
CFLAGS = -Wall -O3 -march=native -flto -fcx-limited-range -fopenmp-simd
CXXFLAGS = -std=c++17 $(CFLAGS) -MMD -MP $(UHD_CFLAGS) $(BOOST_CFLAGS) $(FFTW_CFLAGS)

OBJS = main.o acquisition.o dci_scan.o ofdm.o gscn.o util.o rnti_log.o summary.o fallback_dci.o gf2solve.o NRscrambling.o DCIfactory.o polar.o pbch.o
ifeq ($(strip $(WEBUI)),1)
OBJS += webui.o
CXXFLAGS += -DWITH_WEBUI
endif

all: $(TARGETS)

main: $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ -luhd -lboost_program_options -lfftw3f
	sudo setcap cap_sys_nice=ep $@
	@echo "Compilazione completata: $@"

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# the compiler and flags of the last build: rewritten (so the objects rebuild) only when they change,
# e.g. after editing config.mk
BUILD_FLAGS := $(CXX) $(CXXFLAGS)
.build-flags: FORCE
	@echo '$(BUILD_FLAGS)' | cmp -s - $@ || echo '$(BUILD_FLAGS)' > $@
$(OBJS): .build-flags

# header dependencies, generated by the compiler (-MMD) next to each object
-include $(OBJS:.o=.d)

clean:
	rm -f $(TARGETS) *.o *.d .build-flags

again: clean all

.PHONY: all clean again FORCE
